% newyorker.latex - The New Yorker Inspired Template for New Printer
% Elegant editorial design with sophisticated typography
\documentclass[$if(fontsize)$$fontsize$,$endif$$if(lang)$$babel-lang$,$endif$$if(papersize)$$papersize$paper,$endif$$for(classoption)$$classoption$$sep$,$endfor$]{article}

% Use XeLaTeX for OpenType font support
\usepackage{fontspec}
\usepackage{microtype} % Refined typography and kerning

% Cormorant font family - elegant Old Style serif
\setmainfont{Cormorant}[
  UprightFont = *-Regular,
  BoldFont = *-Bold,
  ItalicFont = *-RegularItalic,
  BoldItalicFont = *-BoldItalic,
  Numbers = OldStyle,
  Ligatures = {Common, TeX}
]

% Sans-serif font for headings and fallback
\setsansfont{Helvetica}[Scale=MatchLowercase]

% Elegant line spacing
\usepackage{setspace}
\setstretch{1.15}

% Page geometry - generous margins for New Yorker feel
\usepackage[margin=$if(geometry)$$geometry$$else$2.5cm$endif$,top=3cm,bottom=3cm]{geometry}

% Multi-column support
\usepackage{multicol}
\usepackage{float}
\usepackage{wrapfig}
\usepackage{needspace}

% Column separation with thin rule - increased spacing to prevent overlap
\setlength{\columnsep}{1.5cm}
\setlength{\columnseprule}{0.2pt}

% Graphics and image handling
\usepackage{graphicx}
\makeatletter
% For images within columns, use column width
\def\maxwidth{\ifdim\Gin@nat@width>\columnwidth\columnwidth\else\Gin@nat@width\fi}
\def\maxheight{\ifdim\Gin@nat@height>0.6\textheight 0.6\textheight\else\Gin@nat@height\fi}
\makeatother
\setkeys{Gin}{width=\maxwidth,height=\maxheight,keepaspectratio}

% Colors for subtle accents
\usepackage{xcolor}
\definecolor{newyorkerblack}{RGB}{33,33,33}
\definecolor{newyorkergray}{RGB}{102,102,102}
\definecolor{linkcolor}{RGB}{0,0,0}

% Sophisticated link styling
$if(colorlinks)$
\usepackage[unicode=true,colorlinks=true,linkcolor=$if(linkcolor)$$linkcolor$$else$linkcolor$endif$,urlcolor=$if(urlcolor)$$urlcolor$$else$linkcolor$endif$,citecolor=$if(citecolor)$$citecolor$$else$linkcolor$endif$]{hyperref}
$else$
\usepackage[unicode=true,hidelinks]{hyperref}
$endif$

% Drop caps for elegant opening paragraphs (commented out - requires full TeX installation)
% \usepackage{lettrine}
% \renewcommand{\LettrineFontHook}{\color{newyorkerblack}}
% \setlength{\DefaultNindent}{0pt}
% \setlength{\DefaultSlope}{0pt}
% \renewcommand{\LettrineTextFont}{\scshape}

% Simple drop cap alternative without lettrine package
\newcommand{\dropcap}[1]{%
  {\Large\textbf{#1}}%
}

% Headers and footers - minimal and elegant
\usepackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
% Remove headers completely
\fancyhead[L]{}
\fancyhead[C]{}
\fancyhead[R]{}
\fancyfoot[C]{\small\thepage}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

% Language support
$if(lang)$
\ifnum 0\ifxetex 1\fi\ifluatex 1\fi=0 % if pdftex
  \usepackage[shorthands=off,$for(babel-otherlangs)$$babel-otherlangs$,$endfor$main=$babel-lang$]{babel}
$if(babel-newcommands)$
  $babel-newcommands$
$endif$
\else
  \usepackage{polyglossia}
  $if(polyglossia-lang.name)$
  \setmainlanguage[$polyglossia-lang.options$]{$polyglossia-lang.name$}
  $else$
  \setmainlanguage{english}
  $endif$
$for(polyglossia-otherlangs)$
  \setotherlanguage[$polyglossia-otherlangs.options$]{$polyglossia-otherlangs.name$}
$endfor$
\fi
$else$
% Default to English
\ifnum 0\ifxetex 1\fi\ifluatex 1\fi=0 % if pdftex
  \usepackage[english]{babel}
\else
  \usepackage{polyglossia}
  \setmainlanguage{english}
\fi
$endif$

% Enhanced math support
$if(math)$
\usepackage{amsmath,amssymb,amsfonts}
$endif$

% Code highlighting
$if(highlighting-macros)$
$highlighting-macros$
$endif$

% List formatting - subtle and refined
\usepackage{enumitem}
\setlist[itemize]{leftmargin=*,label=\textbullet,itemsep=2pt,parsep=2pt,topsep=5pt}
\setlist[enumerate]{leftmargin=*,itemsep=2pt,parsep=2pt,topsep=5pt}

% Paragraph formatting - no indentation, subtle spacing
\usepackage{parskip}
\setlength{\parindent}{0pt}
\setlength{\parskip}{6pt plus 2pt minus 1pt}

% Sophisticated table formatting
$if(tables)$
\usepackage{longtable,booktabs,array}
\usepackage{calc}
\usepackage{caption}
\captionsetup[table]{skip=8pt,font=small,labelfont=sc}
\captionsetup[figure]{skip=8pt,font=small,labelfont=sc}
$endif$

% Quote environment - elegant italic style
\usepackage{csquotes}
\renewenvironment{quote}
  {\small\begin{quotation}\itshape\color{newyorkergray}}
  {\end{quotation}}

% Custom commands
\newcommand{\tightlist}{\setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}

% Define pandocbounded command for image handling
\newcommand{\pandocbounded}[1]{#1}

% Category header command (e.g., "CLIMATE")
\newcommand{\category}[1]{%
  \vspace{2em}%
  \begin{center}%
  \textsc{\small #1}%
  \end{center}%
  \vspace{0.5em}%
}

% Byline command with "BY" prefix
\newcommand{\byline}[1]{%
  \vspace{0.8em}%
  \begin{center}%
  {\scshape\small by #1}%
  \end{center}%
  \vspace{1.5em}%
}

% Hero image command for full-width images
\newcommand{\heroimage}[2][]{%
  \vspace{1em}%
  \noindent%
  \includegraphics[width=\textwidth]{#2}%
  \ifx&#1&%
  \else%
    \par\noindent{\small\itshape #1}%
  \fi%
  \vspace{1.5em}%
}

% Subtitle/deck command (no longer needed, integrated into title block)
\newcommand{\deck}[1]{%
  \vspace{0.5em}%
  \begin{center}%
  {\large\itshape #1}%
  \end{center}%
  \vspace{0.5em}%
}

% Title formatting
$if(title)$
\title{\Huge $title$}
$endif$
$if(author)$
\author{\scshape{$for(author)$$author$$sep$ \and $endfor$}}
$endif$
$if(date)$
\date{$date$}
$endif$

% Additional header includes
$for(header-includes)$
$header-includes$
$endfor$

\begin{document}

% Horizontal rule separator at very top
\noindent\rule{\textwidth}{0.4pt}
\vspace{1em}

% New Yorker-style title layout
$if(category)$
\category{$category$}
$endif$

$if(title)$
\begin{center}
{\Huge $title$}

$if(description)$
\vspace{0.5em}
{\large\itshape $description$}
$endif$
\end{center}

$if(author)$
\byline{$for(author)$$author$$sep$ \and $endfor$}
$endif$
$endif$

% Hero image if provided - full width using entire text width
$if(heroimage)$
\vspace{1em}
\noindent\makebox[\textwidth][c]{%
  \includegraphics[width=\textwidth,height=0.45\textheight,keepaspectratio]{$heroimage$}%
}
\vspace{1.5em}
$endif$

% Begin two-column layout
% Redefine figure environment to prevent overlap in columns
\makeatletter
\let\oldfigure\figure
\let\endoldfigure\endfigure
\renewenvironment{figure}[1][]{%
  \def\@captype{figure}%
  \par\vspace{6pt}\noindent%
  \begin{minipage}{\columnwidth}%
  \centering%
}{%
  \end{minipage}%
  \par\vspace{6pt}%
}
\makeatother

% Start columns after title and hero image
\begin{multicols}{2}
\raggedcolumns

% Abstract or introduction text
$if(abstract)$
{\itshape $abstract$}
\vspace{1em}
$endif$

% Table of contents if requested
$if(toc)$
{
$if(colorlinks)$
\hypersetup{linkcolor=$if(toccolor)$$toccolor$$else$black$endif$}
$endif$
\setcounter{tocdepth}{$toc-depth$}
\tableofcontents
\vspace{1em}
}
$endif$

% Main content
$body$

% End multi-column layout
\end{multicols}

$if(date)$
\vspace{2em}
\begin{flushleft}
{\small\itshape $date$}
\end{flushleft}
$endif$

\end{document}

